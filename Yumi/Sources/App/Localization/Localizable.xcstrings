        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't installed in Ollama."
          }
        }
      }
    },
    "%@ n'est pas prêt. Configure-le dans les réglages, section Moteurs, ou choisis « Automatique ».": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't ready. Set it up in Settings, Engines, or choose \"Automatic\"."
          }
        }
      }
    },
    "%@ n'est pas un fichier": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't a file"
          }
        }
      }
    },
    "%@ n'est pas un fichier texte": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't a text file"
          }
        }
      }
    },
