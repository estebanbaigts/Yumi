      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no longer exists there"
          }
        }
      }
    },
    "%@ ne connaît pas ce modèle pour ta clé. Change le modèle dans les réglages, section Moteurs (ou laisse le champ vide).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doesn't know this model for your key. Change the model in Settings, Engines (or leave the field empty)."
          }
        }
      }
    },
    "%@ ne donne pas de quota gratuit pour ce modèle à ta clé. Choisis un autre modèle dans les réglages, ou un autre moteur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gives your key no free quota for this model. Choose another model in Settings, or another engine."
          }
        }
      }
    },
    "%@ ne m'a pas répondu (%@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ didn't answer me (%2$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ ne m'a pas répondu (%2$@)."
          }
        }
      }
    },
    "%@ personnes de plus te suivent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ more people follow you."
          }
        }
      }
    },
